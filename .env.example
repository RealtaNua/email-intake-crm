# ─────────────────────────────────────────────────────────────
# LOCAL SECRETS — this file is gitignored. Never commit it.
# Fill in every BLANK below. Do not add quotes around values.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Already filled in from what you sent.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# BLANK — Supabase dashboard → Project Settings → API keys → service_role
# Server-side only. Bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# BLANK — Supabase dashboard → Project Settings → Database → Connection string
# Only needed if we run migrations from the CLI. Leave blank for now.
SUPABASE_DB_PASSWORD=

# ── Anthropic ───────────────────────────────────────────────
# BLANK — console.anthropic.com → Settings → API Keys. Starts sk-ant-
ANTHROPIC_API_KEY=

# ── Mailgun ─────────────────────────────────────────────────
# BLANK — Mailgun → Settings → Webhooks → "HTTP webhook signing key".
# NOT the API key. Used to verify inbound POSTs are really from Mailgun.
MAILGUN_SIGNING_KEY=

# BLANK — Mailgun → Settings → API keys → your private/sending API key.
MAILGUN_API_KEY=

# BLANK — the domain receiving mail, e.g. inbox.yourdomain.com
MAILGUN_DOMAIN=

# BLANK — "us" or "eu". If your Mailgun dashboard URL or API base contains
# ".eu.", put eu. Otherwise us.
MAILGUN_REGION=

# BLANK — the full intake address, e.g. intake@inbox.yourdomain.com
INTAKE_EMAIL_ADDRESS=

# ── Cost controls (safe defaults, tune later) ───────────────
# Max inbound emails we will run Claude enrichment on per day.
ENRICHMENT_DAILY_CAP=
# Max inbound webhook POSTs accepted per sender per hour.
WEBHOOK_RATE_LIMIT_PER_SENDER_HOURLY=
